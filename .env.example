# Copy to .env (gitignored) at the repo root. scripts/config.py reads every variable
# below; an empty value counts as unset. Lines that are commented out show the local
# default. In production these come from the Cloud Run service (env vars set by
# infra/admin/setup-admin.sh `run`; the three keys via Secret Manager).

# Database: SQLite locally, Neon Postgres in production. Use the plain libpq form,
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require (scripts/db.py switches the
# driver to psycopg; psql/pg_dump need the plain form).
#DATABASE_URL=sqlite:///./vilf.db

# Media storage: photo originals and the rendered variants (img/).
# A local directory, or gs://vilf-media in production (served at vilf.org/img/).
#VILF_MEDIA_STORAGE=./.media
# Private backup storage; REQUIRED for cloud publishing. Never use the media/site bucket.
#VILF_BACKUP_STORAGE=gs://vilf-backups
# Site storage: where `./vilf publish` mirrors the rendered site. A local directory,
# or gs://vilf-org in production.
#VILF_SITE_STORAGE=./.site
# Canonical site URL used in rendered links, sitemap, JSON-LD and places.json.
#VILF_SITE_URL=https://vilf.org

# CDN invalidation after a publish or photo change: only when both are set
# (vilf-com / vilf-lb in production). Unset locally, so the step is skipped.
GOOGLE_CLOUD_PROJECT=
VILF_URL_MAP=

# Two Google API keys, deliberately separate:
# - GOOGLE_PLACES_API_KEY is a SERVER key for Places API (New), used by spatula,
#   check, audit, enrich and the admin's lookup/relink. It never reaches a browser;
#   restrict it to the Places API (New) only.
# - GOOGLE_MAPS_EMBED_API_KEY is a BROWSER key for the Maps Embed API: it appears
#   verbatim in the admin's <iframe src=...> so restrict it by HTTP referrer
#   (https://admin.vilf.org/*, https://vilf-admin-*.run.app/*, http://localhost:8000/*).
#   Leave empty to hide the map.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_EMBED_API_KEY=

# Who may use the admin. Unset locally: requests without IAP headers run as VILF_DEV_USER.
# itsi@vilf.org in production, where IAP supplies the signed-in identity and only this
# email is accepted.
VILF_ADMIN_EMAIL=
# Identity recorded in the runs table when not behind IAP (local dev).
#VILF_DEV_USER=dev@localhost

# Ping IndexNow with fresh sitemap URLs after a publish: 0 locally, 1 in production.
#VILF_INDEXNOW=0

# Port for `./vilf serve`. Local only: the container always listens on 8080.
#PORT=8000
