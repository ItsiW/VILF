# Copy to .env (gitignored). Create the key in the vilf-com GCP project with Places API (New) enabled.
GOOGLE_PLACES_API_KEY=

# Database. Local default is SQLite; production is Postgres in SQLAlchemy form
# (postgresql+psycopg://USER:PASSWORD@HOST/DB), supplied by Secret Manager on Cloud Run.
#DATABASE_URL=sqlite:///./vilf.db

# Where uploaded photos and derived images live: a local directory or gs://vilf-media.
#VILF_MEDIA_STORAGE=./.media
# Where the published site is written: a local directory or gs://vilf-org.
#VILF_SITE_STORAGE=./.site
# Canonical site URL used in rendered links, sitemap and JSON-LD.
#VILF_SITE_URL=https://vilf.org

# Only needed to invalidate the CDN after a publish (project and url map of the load balancer).
GOOGLE_CLOUD_PROJECT=
VILF_URL_MAP=

# Maps Embed API key for the map preview in the admin app (separate key from Places).
GOOGLE_MAPS_EMBED_API_KEY=

# Who may publish; in production IAP supplies the identity of the signed-in user.
VILF_ADMIN_EMAIL=
# Identity used when not behind IAP (local dev).
#VILF_DEV_USER=dev@localhost

# Ping IndexNow after publishing: 0 locally, 1 in production.
#VILF_INDEXNOW=0

# Local dev server port. The container always listens on 8080.
#PORT=8000
