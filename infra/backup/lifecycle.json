{
  "rule": [
    {"action": {"type": "Delete"}, "condition": {"age": 30, "isLive": true, "matchesPrefix": ["daily/"]}},
    {"action": {"type": "Delete"}, "condition": {"daysSinceNoncurrentTime": 30, "isLive": false, "matchesPrefix": ["originals/"]}},
    {"action": {"type": "Delete"}, "condition": {"isLive": false, "age": 30, "matchesPrefix": ["daily/", "status/"]}}
  ]
}
